<Window x:Class="Lumina.BrightnessOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Brightness"
        Width="270"
        Height="56"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Border Margin="6"
            CornerRadius="12"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="14,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brightness Icon -->
            <ui:SymbolIcon x:Name="OsdIcon"
                           Grid.Column="0"
                           Symbol="BrightnessHigh24"
                           FontSize="20"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center" />

            <!-- Progress Bar -->
            <ProgressBar x:Name="OsdProgressBar"
                         Grid.Column="1"
                         Height="6"
                         Minimum="0"
                         Maximum="100"
                         Value="50"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                         VerticalAlignment="Center" />

            <!-- Percentage Text -->
            <TextBlock x:Name="OsdPercentageText"
                       Grid.Column="2"
                       Text="50%"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Width="38"
                       TextAlignment="Right" />
        </Grid>
    </Border>
</Window>
