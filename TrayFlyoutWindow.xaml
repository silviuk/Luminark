<Window x:Class="Lumina.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Luminark Quick Controls"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Margin="12"
            CornerRadius="12"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#000000" />
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Header -->
                <RowDefinition Height="Auto" /> <!-- 1: Status Card -->
                <RowDefinition Height="Auto" /> <!-- 2: Action Buttons -->
                <RowDefinition Height="Auto" /> <!-- 3: Prevent Sleep -->
                <RowDefinition Height="Auto" /> <!-- 4: Master Brightness -->
                <RowDefinition Height="Auto" /> <!-- 5: Individual Monitors -->
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="5.5" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1.2" ClipToBounds="True" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="#1E1E24" />
                            <Rectangle Grid.Column="1" Fill="#FFFFFF" />
                            <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="Luminark" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Toggle Theme Button -->
                    <ui:Button Appearance="Secondary"
                               Click="OnToggleThemeClicked"
                               ToolTip="Toggle Dark / Light Mode"
                               Padding="8,5"
                               Margin="0,0,6,0">
                        <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:Button>

                    <!-- Open Full App Dashboard -->
                    <ui:Button Appearance="Secondary"
                               Click="OnOpenFullDashboardClicked"
                               ToolTip="Open Full Settings Dashboard"
                               Padding="8,5">
                        <ui:SymbolIcon Symbol="Open24" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- 1. Automation Status Card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Symbol="Clock24"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AutomationModeText, FallbackValue='Active Schedule'}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding NextToggleStatusText, FallbackValue='Calculating next transition...'}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Action Buttons -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Link Displays Toggle -->
                <ui:Button Grid.Column="0"
                           Appearance="Secondary"
                           Click="OnToggleLinkMonitorsClicked"
                           HorizontalAlignment="Stretch"
                           Padding="6,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Link24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding LinkMonitorsButtonText, FallbackValue='Linked'}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ui:Button>

                <!-- Lock Screen & Turn Off Monitors -->
                <ui:Button Grid.Column="2"
                           Appearance="Secondary"
                           Click="OnLockAndTurnOffClicked"
                           HorizontalAlignment="Stretch"
                           Padding="6,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding LockCountdownText, FallbackValue='Lock &amp; Screen Off'}" 
                                   Visibility="{Binding IsLockingCountdown, Converter={StaticResource BoolToVis}}" 
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="Lock &amp; Screen Off" 
                                   Visibility="{Binding IsNotLockingCountdown, Converter={StaticResource BoolToVis}}" 
                                   FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- 3. Prevent Computer Sleep Checkbox -->
            <CheckBox Grid.Row="3"
                      Content="Prevent computer sleep"
                      FontSize="12"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      IsChecked="{Binding PreventSleep, Mode=TwoWay}"
                      Margin="2,0,0,10"
                      VerticalAlignment="Center"
                      ToolTip="Keeps system and display awake, preventing automatic idle sleep" />

            <!-- 4. Master Brightness -->
            <Border Grid.Row="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BrightnessHigh24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Master Brightness" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding MasterBrightnessText, FallbackValue='80%'}"
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>

                    <Slider Value="{Binding MasterBrightness, Mode=TwoWay}"
                            Minimum="0"
                            Maximum="100"
                            SmallChange="5"
                            LargeChange="10"
                            Margin="0,4,0,8" />

                    <!-- Quick Presets -->
                    <UniformGrid Columns="4" Margin="0,2,0,0">
                        <ui:Button Appearance="Secondary" Content="25%" Click="OnPresetClicked" Tag="25" Margin="0,0,3,0" Padding="0,4" FontSize="11" HorizontalAlignment="Stretch" />
                        <ui:Button Appearance="Secondary" Content="50%" Click="OnPresetClicked" Tag="50" Margin="3,0,3,0" Padding="0,4" FontSize="11" HorizontalAlignment="Stretch" />
                        <ui:Button Appearance="Secondary" Content="75%" Click="OnPresetClicked" Tag="75" Margin="3,0,3,0" Padding="0,4" FontSize="11" HorizontalAlignment="Stretch" />
                        <ui:Button Appearance="Secondary" Content="100%" Click="OnPresetClicked" Tag="100" Margin="3,0,0,0" Padding="0,4" FontSize="11" HorizontalAlignment="Stretch" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 5. Individual Monitors (Visible when unlinked) -->
            <ItemsControl Grid.Row="5"
                          ItemsSource="{Binding Monitors}"
                          Margin="0,4,0,0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitorsLinked}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <ui:SymbolIcon Symbol="Desktop24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="230"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentBrightness, StringFormat='{}{0}%'}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Value="{Binding CurrentBrightness, Mode=TwoWay}"
                                        Minimum="{Binding MinBrightness}"
                                        Maximum="{Binding MaxBrightness}"
                                        SmallChange="5"
                                        LargeChange="10" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
