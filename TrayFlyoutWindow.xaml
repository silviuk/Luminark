<Window x:Class="Lumina.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Lumina Quick Controls"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Margin="12"
            CornerRadius="14"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.38" Color="#000000" />
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Automation Status Card -->
                <RowDefinition Height="Auto" /> <!-- Quick Actions -->
                <RowDefinition Height="Auto" /> <!-- Brightness Controls -->
                <RowDefinition Height="Auto" /> <!-- Individual Monitors (if unlinked) -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:FontIcon Glyph="&#xE706;" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Lumina" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Toggle Theme Button -->
                    <Button Click="OnToggleThemeClicked"
                            ToolTip="Toggle Dark/Light Mode"
                            Padding="8,5"
                            Margin="0,0,6,0">
                        <ui:FontIcon Glyph="&#xE708;" FontSize="14" />
                    </Button>

                    <!-- Open Full App Dashboard -->
                    <Button Click="OnOpenFullDashboardClicked"
                            ToolTip="Open Full Settings Dashboard"
                            Padding="8,5">
                        <ui:FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Automation Status Card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:FontIcon Glyph="{Binding AutomationModeIcon, FallbackValue='&#xE708;'}"
                                 FontSize="16"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AutomationModeText, FallbackValue='Automated Schedule'}"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                        <TextBlock Text="{Binding NextToggleStatusText, FallbackValue='Calculating next toggle...'}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Quick Action Buttons (Link Displays & Lock/Turn Off) -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Link Displays Toggle -->
                <Button Grid.Column="0"
                        Click="OnToggleLinkMonitorsClicked"
                        HorizontalAlignment="Stretch"
                        Padding="6,7">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:FontIcon Glyph="{Binding LinkMonitorsIcon, FallbackValue='&#xE71B;'}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding LinkMonitorsButtonText, FallbackValue='Linked'}" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Lock Screen & Turn Off Monitors -->
                <Button Grid.Column="2"
                        Click="OnLockAndTurnOffClicked"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Padding="6,7">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE72E;" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding LockCountdownText, FallbackValue='Lock &amp; Sleep'}" 
                                   Visibility="{Binding IsLockingCountdown, Converter={StaticResource BoolToVis}}" 
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="Lock &amp; Sleep" 
                                   Visibility="{Binding IsNotLockingCountdown, Converter={StaticResource BoolToVis}}" 
                                   FontSize="11" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Lock Delay Quick Selector (Under actions) -->
            <StackPanel Grid.Row="2" Margin="0,38,0,10" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Lock delay:" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="75"
                          FontSize="10"
                          Padding="4,2"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding LockScreenDelaySeconds, Mode=TwoWay}">
                    <ComboBoxItem Content="Instant" Tag="0" />
                    <ComboBoxItem Content="3 sec" Tag="3" />
                    <ComboBoxItem Content="5 sec" Tag="5" />
                    <ComboBoxItem Content="10 sec" Tag="10" />
                </ComboBox>
            </StackPanel>

            <!-- 4. Master Brightness -->
            <Border Grid.Row="3"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE706;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Master Brightness" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding MasterBrightnessText, FallbackValue='80%'}"
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>

                    <Slider Value="{Binding MasterBrightness, Mode=TwoWay}"
                            Minimum="0"
                            Maximum="100"
                            SmallChange="5"
                            LargeChange="10"
                            Margin="0,4,0,8" />

                    <!-- Quick Presets -->
                    <UniformGrid Columns="4" Margin="0,2,0,0">
                        <Button Content="25%" Click="OnPresetClicked" Tag="25" Margin="0,0,3,0" Padding="0,4" FontSize="11" />
                        <Button Content="50%" Click="OnPresetClicked" Tag="50" Margin="3,0,3,0" Padding="0,4" FontSize="11" />
                        <Button Content="75%" Click="OnPresetClicked" Tag="75" Margin="3,0,3,0" Padding="0,4" FontSize="11" />
                        <Button Content="100%" Click="OnPresetClicked" Tag="100" Margin="3,0,0,0" Padding="0,4" FontSize="11" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 5. Individual Monitors (Rendered if Unlinked) -->
            <ItemsControl Grid.Row="4"
                          ItemsSource="{Binding Monitors}"
                          Margin="0,4,0,0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitorsLinked}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="240"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding CurrentBrightness, StringFormat='{}{0}%'}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Value="{Binding CurrentBrightness, Mode=TwoWay}"
                                        Minimum="{Binding MinBrightness}"
                                        Maximum="{Binding MaxBrightness}"
                                        SmallChange="5"
                                        LargeChange="10" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
